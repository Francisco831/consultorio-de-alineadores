# Proyecto Supabase PROPIO de finanzas (NO el del CRM).
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Server-only: seeds, importadores y (a futuro) crons. NUNCA en el cliente.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Solo scripts de terminal (runner de migraciones). NO se cargan en Vercel.
SUPABASE_DB_PASSWORD=<database password>
SUPABASE_PROJECT_REF=<ref>

# Crons de Vercel (Etapa 2+)
CRON_SECRET=<random largo>
