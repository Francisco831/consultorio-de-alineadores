# Proyecto Supabase (Settings → API en el dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo para scripts de import/seed — NUNCA exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Contraseña de Postgres (Settings → Database → Database password).
# La usan scripts/db-migrate.ts y scripts/security-checks.ts, que conectan
# por el pooler en vez de PostgREST.
SUPABASE_DB_PASSWORD=

# --- Capa AI (opcionales: sin la clave, /api/ai/* responde 503 y el CRM anda igual)
ANTHROPIC_API_KEY=
# Default: claude-opus-5
AI_MODEL=
# low | medium | high | xhigh | max. Default high. Es la perilla de costo/calidad:
# la salida (sobre todo pensamiento) fue el 44% del costo de analizar un doctor.
AI_EFFORT=
# Corta-corriente de gasto diario en USD. Default 25. Al alcanzarlo, las rutas que
# llaman al modelo responden 429 hasta el día siguiente. Referencia medida:
# ~USD 0,42 por análisis de doctor con effort high.
AI_DAILY_BUDGET_USD=

# --- Solo para operar contra una base puntual (ver docs/OPERACION.md)
# OJO: SUPABASE_PROJECT_REF lo leen únicamente scripts/lib/pg.ts y db-migrate.ts.
# Los scripts que escriben con supabase-js van por NEXT_PUBLIC_SUPABASE_URL, y
# frenan si las dos fuentes no coinciden.
SUPABASE_PROJECT_REF=
SUPABASE_DB_HOST=

# --- Webhook de Periskope (refresco en tiempo real de wa_conversations)
# Token propio (lo generamos con `openssl rand -hex 32`). Va en esta env (Vercel
# prod) y en la URL del webhook configurada en la consola de Periskope, como
# ?k=<token>. El endpoint /api/webhooks/periskope rechaza con 401 todo POST cuyo
# ?k no coincida. Sin la variable, el endpoint responde 503 (apagado).
PERISKOPE_WEBHOOK_SECRET=
